---
import '../../styles/admin.css';
import { stages, stageLabels } from '../../lib/commercial';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Comercial | Linear Admin</title>
  </head>
  <body>
    <div class="workspace">
      <aside class="sidebar">
        <a href="/admin/" class="admin-brand"><span class="brand-symbol">L</span>Linear <small>ADMIN</small></a>
        <p class="nav-label">GESTÃO</p>
        <nav aria-label="Administração">
          <button type="button" data-view="overview" aria-current="page"><i data-lucide="layout-dashboard"></i>Visão geral</button>
          <button type="button" data-view="leads"><i data-lucide="users"></i>Oportunidades</button>
          <button type="button" data-view="agenda"><i data-lucide="calendar-days"></i>Próximos contatos</button>
        </nav>
        <div class="sidebar-bottom"><a href="/" target="_blank" rel="noopener"><i data-lucide="arrow-up-right"></i>Site da Linear</a><a href="/cdn-cgi/access/logout"><i data-lucide="log-out"></i>Sair</a><p>Linear Inteligência Industrial</p></div>
      </aside>
      <div class="main-area">
        <header class="topbar"><span>Gestão comercial <span class="divider">/</span> <strong id="breadcrumb">Visão geral</strong></span><span class="identity"><i data-lucide="shield-check"></i><span id="identity">Verificando acesso</span></span></header>
        <main>
          <div id="local-notice" class="local-notice" hidden>Ambiente local · dados de teste separados da produção</div>
          <div class="page-heading"><div><p class="eyebrow" id="today"></p><h1 id="page-title">Visão geral</h1></div><button class="primary" id="new-lead" disabled><i data-lucide="plus"></i>Nova oportunidade</button></div>
          <div id="status" role="status" aria-live="polite">Carregando oportunidades...</div>
          <section id="overview" aria-label="Indicadores comerciais">
            <div class="metrics">
              <div><span>Oportunidades abertas</span><strong id="metric-open">—</strong><small>Em acompanhamento</small></div>
              <div><span>Valor em negociação</span><strong id="metric-pipeline">—</strong><small>Oportunidades abertas</small></div>
              <div><span>Retornos atrasados</span><strong id="metric-overdue">—</strong><small>Contatos pendentes</small></div>
              <div><span>Negócios ganhos</span><strong id="metric-won">—</strong><small>Valor contratado · todo o período</small></div>
            </div>
            <div class="overview-columns">
              <section class="pipeline"><div class="section-heading"><h2>Funil comercial</h2><span id="pipeline-count"></span></div><div id="pipeline-bars"></div></section>
              <section class="priorities"><div class="section-heading"><h2>Na sua agenda</h2><button class="text-button" data-view="agenda">Ver contatos <i data-lucide="arrow-right"></i></button></div><div id="priority-list"></div></section>
            </div>
          </section>
          <section class="records" aria-label="Oportunidades">
            <div class="section-heading"><h2 id="list-title">Todas as oportunidades</h2><div class="list-actions"><span id="result-count"></span><button id="export" class="icon-button" title="Exportar oportunidades em CSV" aria-label="Exportar oportunidades em CSV" disabled><i data-lucide="download"></i></button><button id="refresh" class="icon-button" title="Atualizar" aria-label="Atualizar"><i data-lucide="refresh-cw"></i></button></div></div>
            <div class="filters"><label class="search"><i data-lucide="search"></i><input id="search" type="search" placeholder="Buscar empresa ou contato" aria-label="Buscar empresa ou contato" /></label><select id="stage-filter" aria-label="Filtrar por etapa"><option value="">Todas as etapas</option>{stages.map(stage => <option value={stage}>{stageLabels[stage]}</option>)}</select><select id="due-filter" aria-label="Filtrar por próximo contato"><option value="">Todos os contatos</option><option value="overdue">Atrasados</option><option value="today">Hoje</option><option value="upcoming">Futuros</option><option value="unscheduled">Sem agendamento</option></select></div>
            <div class="table-scroll"><table><thead><tr><th>Empresa / contato</th><th>Etapa</th><th>Valor estimado</th><th>Próximo contato</th><th>Próxima ação</th><th><span class="sr-only">Abrir oportunidade</span></th></tr></thead><tbody id="lead-rows"></tbody></table></div>
            <div class="empty" id="empty" hidden><i data-lucide="notebook-pen"></i><h3 id="empty-title">Nenhuma oportunidade cadastrada</h3><p id="empty-description">Seu acompanhamento comercial começa aqui.</p><button class="primary" id="empty-create"><i data-lucide="plus"></i>Nova oportunidade</button></div>
          </section>
        </main>
        <footer class="admin-footer"><span>Linear · Gestão interna</span><span id="sync-status"></span></footer>
      </div>
    </div>
    <dialog id="lead-dialog" aria-labelledby="dialog-title">
      <div class="dialog-heading"><div><p class="eyebrow">COMERCIAL</p><h2 id="dialog-title">Nova oportunidade</h2></div><button class="icon-button" id="close-dialog" type="button" aria-label="Fechar" title="Fechar"><i data-lucide="x"></i></button></div>
      <form id="lead-form">
        <div class="form-grid">
          <label class="wide">Empresa *<input name="company" required maxlength="160" autocomplete="organization" /></label>
          <label>Contato<input name="contact" maxlength="160" autocomplete="name" /></label>
          <label>E-mail<input name="email" type="email" maxlength="254" autocomplete="email" /></label>
          <label>Telefone<input name="phone" type="tel" maxlength="40" autocomplete="tel" /></label>
          <label>Origem<input name="source" maxlength="100" placeholder="Indicação, evento, site..." /></label>
          <label>Etapa<select name="stage">{stages.map(stage => <option value={stage}>{stageLabels[stage]}</option>)}</select></label>
          <label>Valor estimado (R$)<input name="value" type="number" min="0" max="1000000000" step="0.01" value="0" required /></label>
          <label>Próximo contato<input name="nextContact" type="date" /></label>
          <label>Próxima ação<input name="nextAction" maxlength="300" /></label>
          <label class="wide">Observações<textarea name="notes" rows="3" maxlength="5000"></textarea></label>
        </div>
        <p id="form-error" role="alert"></p>
        <div class="form-actions"><button id="delete-lead" type="button" class="danger" hidden><i data-lucide="trash-2"></i>Excluir</button><button type="submit" class="primary" id="save-lead"><i data-lucide="check"></i>Salvar oportunidade</button></div>
      </form>
      <section id="history" hidden><h3>Histórico de contatos</h3><form id="activity-form"><label>Registrar contato<textarea id="activity-text" rows="2" maxlength="2000" required></textarea></label><button class="secondary" type="submit" id="save-activity"><i data-lucide="plus"></i>Registrar</button></form><p id="activity-error" role="alert"></p><div id="activities"></div></section>
    </dialog>
    <dialog id="delete-dialog" aria-labelledby="delete-title"><h2 id="delete-title">Excluir oportunidade?</h2><p>A oportunidade e seu histórico de contatos serão excluídos.</p><div class="form-actions"><button class="secondary" id="cancel-delete">Cancelar</button><button class="danger" id="confirm-delete">Excluir oportunidade</button></div><p id="delete-error" role="alert"></p></dialog>
    <script src="../../scripts/admin.ts"></script>
  </body>
</html>
