{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linearpage-local",
  "main": "worker/local.ts",
  "compatibility_date": "2026-09-29",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "ADMIN_EMAIL": "gustavo.maciel@linearintelligence.com.br" },
  "d1_databases": [{ "binding": "DB", "database_name": "linear-admin-local", "database_id": "local", "migrations_dir": "migrations" }]
}
